{
  "name": "ipyregulartable",
  "version": "0.3.7",
  "description": "An ipywidgets wrapper around regular-table",
  "repository": "git@github.com:finos/ipyregulartable.git",
  "author": "The ipyregulartable authors <t.paine154@gmail.com>",
  "license": "Apache-2.0",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension"
  ],
  "main": "lib/index.js",
  "files": [
    "lib/**/*.js",
    "dist/*.js",
    "style/**/*.css"
  ],
  "jupyterlab": {
    "extension": "lib/plugin.js",
    "outputDir": "../ipyregulartable/labextension",
    "discovery": {
      "server": {
        "base": {
          "name": "ipyregulartable"
        },
        "managers": [
          "pip"
        ]
      }
    }
  },
  "scripts": {
    "build:babel": "babel src/ --source-maps --out-dir lib/",
    "build:extension": "mkdirp ../ipyregulartable/extension/ && cpy --flat 'src/extension/*' '../ipyregulartable/extension/'",
    "build:nbextension": "webpack --mode=production",
    "build:labextension": "rimraf ../ipyregulartable/labextension && jupyter labextension build .",
    "build": "pnpm clean && pnpm build:babel && pnpm build:extension && pnpm build:labextension && pnpm build:nbextension",
    "clean": "rimraf lib dist ../ipyregulartable/nbextension/static/index.js ../ipyregulartable/nbextension/static/index.js.map",
    "fix": "pnpm lint --fix",
    "lint": "eslint -c .eslintrc.js --ext .js src/ tests/",
    "preinstall": "npx only-allow pnpm",
    "prepublishOnly": "pnpm run build",
    "test": "jest --coverage --collectCoverageFrom=src/*.{js}"
  },
  "dependencies": {
    "@jupyter-widgets/base": "^6.0.5",
    "mathjs": "^15.2.0",
    "regular-table": "^0.8.5"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/preset-env": "^7.29.2",
    "@jupyterlab/builder": "^4.5.6",
    "babel-jest": "^30.4.1",
    "css-loader": "^6.8.1",
    "cpy-cli": "^6.0.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.12.1",
    "eslint-plugin-json": "^3.1.0",
    "eslint-plugin-prettier": "^5.5.4",
    "isomorphic-fetch": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-junit": "^17.0.0",
    "jest-transform-css": "^6.0.3",
    "mkdirp": "^3.0.1",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "source-map-loader": "^4.0.1",
    "style-loader": "^3.3.3",
    "webpack": "^5.104.1",
    "webpack-cli": "^5.1.4"
  }
}
